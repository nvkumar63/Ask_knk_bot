# Telegram (from @BotFather)
TELEGRAM_TOKEN=YOUR_TELEGRAM_BOT_TOKEN

# Google Gemini AI
GEMINI_API_KEY=YOUR_GEMINI_API_KEY

# Your Telegram Admin ID
ADMIN_CHAT_ID=YOUR_TELEGRAM_CHAT_ID

# Bot behaviour
DB_PATH=bot.db
GEMINI_MODEL=gemini-pro
FLASK_PORT=5000

# Contact message shown when bot cannot answer
CONTACT_MESSAGE=Sorry, I can only answer questions about our services. Please contact us directly.
BOT_SCOPE=This bot answers questions about our company only.
